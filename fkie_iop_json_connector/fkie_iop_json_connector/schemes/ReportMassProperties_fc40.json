{
  "title": "ReportMassProperties",
  "messageId": "fc40",
  "isCommand": false,
  "description": "ReportMassProperties returns a list of mass properties. Each sequence \n          in the list includes an identifying index for the coordinate system and a mass records in that \n          coordinate system. Each mass record provides the mass and center of mass location for an element. \n          Most components will consist of only one such element; others, such as a Manipulator, will be represented \n          by a group of elements, so that the changing configuration of the Manipulator can be represented \n          (and its center of mass determined).",
  "type": "object",
  "properties": {
    "HeaderRec": {
      "type": "object",
      "comment": "",
      "required": [
        "MessageID"
      ],
      "properties": {
        "MessageID": {
          "type": "string",
          "jausType": "unsigned short integer",
          "comment": "",
          "const": "fc40"
        }
      }
    },
    "MassPropertyList": {
      "type": "array",
      "comment": "",
      "required": [],
      "items": {
        "anyOf": [
          {
            "type": "object",
            "comment": "",
            "required": [
              "CoordinateFrameVar",
              "MassPropertiesRecord"
            ],
            "properties": {
              "CoordinateFrameVar": {
                "type": "object",
                "comment": "",
                "required": [],
                "properties": {
                  "ModuleFrameVar": {
                    "type": "object",
                    "comment": "",
                    "required": [],
                    "properties": {},
                    "jausType": "unsigned byte",
                    "vtagMin": 0,
                    "vtagMax": 0,
                    "isVariant": true
                  },
                  "LinkFrameRec": {
                    "type": "object",
                    "comment": "",
                    "required": [
                      "LinkIndex"
                    ],
                    "properties": {
                      "LinkIndex": {
                        "type": "number",
                        "jausType": "unsigned byte",
                        "comment": "Index of the serial manipulator link for the selected coordinate frame."
                      }
                    }
                  },
                  "StabilizerFrameRec": {
                    "type": "object",
                    "comment": "",
                    "required": [
                      "StabilizerID"
                    ],
                    "properties": {
                      "StabilizerID": {
                        "type": "number",
                        "jausType": "unsigned byte",
                        "comment": "ID of the stabilizer which the coordinate frame is representing"
                      }
                    }
                  },
                  "AttachmentFrameRec": {
                    "type": "object",
                    "comment": "",
                    "required": [
                      "HostNodeID",
                      "AttachmentID"
                    ],
                    "properties": {
                      "HostNodeID": {
                        "type": "number",
                        "jausType": "unsigned byte",
                        "comment": "Node ID of the module that hosts the attachment point"
                      },
                      "AttachmentID": {
                        "type": "number",
                        "jausType": "unsigned byte",
                        "comment": "ID of the attachment which the coordinate frame is representing"
                      }
                    }
                  }
                },
                "jausType": "unsigned byte",
                "vtagMin": 0,
                "vtagMax": 3,
                "isVariant": true
              },
              "MassPropertiesRecord": {
