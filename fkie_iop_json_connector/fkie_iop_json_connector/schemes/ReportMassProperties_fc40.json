                    "type": "number",
                    "jausType": "unsigned integer",
                    "comment": "Mass of the component. A value of zero is recognized as invalid.",
                    "scaleRange": {
                      "scaleFactor": 2.3283064370807974e-06,
                      "bias": 0.0
                    }
                  },
                  "CenterOfMassX": {
                    "type": "number",
                    "jausType": "unsigned integer",
                    "comment": "Center of mass of the component, relative to the center of the selected coordinate frame",
                    "scaleRange": {
