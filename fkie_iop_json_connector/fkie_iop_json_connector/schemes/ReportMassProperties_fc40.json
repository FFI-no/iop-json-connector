                    "comment": "Moment of inertia of the component (relative to center of mass) in kilogram meters squared"
                  },
                  "MomentOfInertialTensorXY": {
                    "type": "UNKNOWN",
                    "jausType": "float",
                    "comment": "Moment of inertia of the component (relative to center of mass) in kilogram meters squared"
