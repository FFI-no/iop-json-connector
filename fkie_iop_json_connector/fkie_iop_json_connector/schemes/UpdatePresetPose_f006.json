{
  "title": "UpdatePresetPose",
  "messageId": "f006",
  "isCommand": true,
  "description": "Adds, removes, or modifies one or more preset poses.  The ConfirmUpdatePresetPose \n                    message response indicates if the operation succeeded. An implementation may support \n                    all, some, or none of the operations of this message and will indicate so in the \n                    response.  This is an atomic operation where either all pose updates succeed, \n                    or all fail. When deleting a preset pose, the TransitionList and \n                    PresetPositionsList may be empty.",
  "type": "object",
  "properties": {
    "HeaderRec": {
      "type": "object",
      "comment": "",
      "required": [
        "MessageID"
      ],
      "properties": {
        "MessageID": {
          "type": "string",
          "jausType": "unsigned short integer",
          "comment": "",
          "const": "f006"
        }
      }
    },
    "UpdatePresetPoseSequence": {
