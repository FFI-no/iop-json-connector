                {
                  "valueEnum": {
                    "enumIndex": 0,
                    "enumConst": "ADD_PRESET_POSE"
                  }
                },
                {
                  "valueEnum": {
                    "enumIndex": 1,
                    "enumConst": "REMOVE_PRESET_POSE"
                  }
                },
                {
                  "valueEnum": {
                    "enumIndex": 2,
                    "enumConst": "UPDATE_PRESET_POSE"
                  }
                }
              ],
              "enum": [
                "ADD_PRESET_POSE",
                "REMOVE_PRESET_POSE",
                "UPDATE_PRESET_POSE"
              ]
            }
          }
        },
