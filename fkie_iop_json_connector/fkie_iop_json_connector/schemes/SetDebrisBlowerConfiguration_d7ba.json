{
  "title": "SetDebrisBlowerConfiguration",
  "messageId": "d7ba",
  "isCommand": true,
  "description": "This message is used to turn on/off a debris blower, and optionally set the discharge direction (if supported).  The direction is defined by the azimuth and elevation.  Azimuth is the horizontal direction, where zero represents the forward direction of travel for the vehicle and positive values point to the vehicle\u2019s right side.  Elevation is the vertical direction, where zero represents the direction parallel to the ground and positive values point up.  Note that this message may be ignored if an unsupported OnOffStatus, Azimuth, or Elevation value are requested.",
  "type": "object",
  "properties": {
    "HeaderRec": {
      "type": "object",
      "comment": "",
      "required": [
        "MessageID"
      ],
      "properties": {
        "MessageID": {
          "type": "string",
          "jausType": "unsigned short integer",
          "comment": "",
          "const": "d7ba"
        }
      }
    },
