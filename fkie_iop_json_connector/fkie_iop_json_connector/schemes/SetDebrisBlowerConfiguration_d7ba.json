      "type": "object",
      "comment": "",
      "required": [
        "presenceVector"
      ],
      "properties": {
        "presenceVector": {
          "type": "number",
          "jausType": "unsigned byte",
          "comment": ""
        },
        "OnOffStatus": {
          "type": "string",
          "jausType": "unsigned byte",
          "comment": "",
          "valueSet": [
            {
              "valueEnum": {
                "enumIndex": 0,
                "enumConst": "OFF"
              }
            },
            {
              "valueEnum": {
                "enumIndex": 1,
                "enumConst": "ON_SingleSpeed"
              }
            },
            {
