        "RequestID",
        "Status"
      ],
      "properties": {
        "RequestID": {
          "type": "number",
          "jausType": "unsigned byte",
          "comment": "Unique identifier associated with a SetCurrentPose request."
        },
        "Status": {
          "type": "string",
          "jausType": "unsigned byte",
          "comment": "",
          "valueSet": [
            {
              "valueEnum": {
