              "bitRange": {
                "from": 2,
                "to": 3
              },
              "valueSet": [
                {
                  "valueEnum": {
                    "enumIndex": 0,
                    "enumConst": "Continue"
                  }
                },
                {
                  "valueEnum": {
                    "enumIndex": 1,
                    "enumConst": "RemoveFollower"
                  }
                },
                {
                  "valueEnum": {
                    "enumIndex": 2,
                    "enumConst": "StopLeader"
                  }
                }
              ],
              "enum": [
                "Continue",
                "RemoveFollower",
                "StopLeader"
              ]
            }
