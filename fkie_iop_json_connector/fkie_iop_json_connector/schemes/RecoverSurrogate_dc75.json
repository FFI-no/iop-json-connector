              "type": "string",
              "jausType": "unsigned byte",
              "comment": "Enumerated field that specifies the type of emergency recovery to perform. The only currently defined operation is IMMEDIATE, which indicates the surrogate should take action to recover to a recovery / landed position as quickly as possible. It is up to the implementation to determine how this occurs. NOTE: An emergency recovery does not necessarily happen on the launching vehicle. For example, a UAV may land on the ground immediately below it as part of its emergency recovery procedure.",
              "valueSet": [
                {
                  "valueEnum": {
                    "enumIndex": 0,
                    "enumConst": "IMMEDIATE"
                  }
                },
                {
                  "valueRange": {
                    "minimum": 1.0,
                    "maximum": 64.0,
                    "interpretation": "Reserved for future use."
                  }
                },
                {
                  "valueRange": {
                    "minimum": 65.0,
                    "maximum": 255.0,
                    "interpretation": "Implementation specific."
                  }
                }
              ],
              "enum": [
                "IMMEDIATE"
              ]
            }
          }
