{
  "title": "ReportGlobalLoiter",
  "messageId": "4425",
  "isCommand": false,
  "description": "This message is used to provide the receiver with the current values of the safety zones. The message data for this message are identical to the ID 0425h: SetGlobalLoiter message.",
  "type": "object",
  "properties": {
    "HeaderRec": {
      "type": "object",
      "comment": "",
      "required": [
        "MessageID"
      ],
      "properties": {
        "MessageID": {
          "type": "string",
          "jausType": "unsigned short integer",
          "comment": "A two byte field to hold the message ID of a message",
          "const": "4425"
        }
      }
    },
    "GlobalLoiterSpecification": {
      "type": "object",
      "comment": "",
      "required": [
        "GlobalLoiterRec",
        "Loiter"
      ],
      "properties": {
        "GlobalLoiterRec": {
          "type": "object",
          "comment": "",
          "required": [
            "presenceVector",
            "Latitude",
            "Longitude"
          ],
          "properties": {
            "presenceVector": {
              "type": "number",
              "jausType": "unsigned byte",
              "comment": ""
            },
            "Latitude": {
              "type": "number",
              "jausType": "unsigned integer",
              "comment": "Decimal degrees",
              "scaleRange": {
                "scaleFactor": 4.190951586745435e-08,
                "bias": -90.0
              }
            },
            "Longitude": {
              "type": "number",
              "jausType": "unsigned integer",
              "comment": "Decimal degrees",
              "scaleRange": {
                "scaleFactor": 8.38190317349087e-08,
                "bias": -180.0
              }
            },
            "ZPosition": {
              "type": "array",
              "comment": "",
              "required": [],
              "items": {
                "anyOf": [
                  {
                    "type": "number",
                    "jausType": "unsigned integer",
                    "comment": "",
                    "fieldIndex": 0,
                    "fieldUnits": "meter",
                    "scaleRange": {
                      "scaleFactor": 2.3283064370807974e-05,
                      "bias": -50000.0
                    }
                  },
                  {
                    "type": "number",
                    "jausType": "unsigned integer",
                    "comment": "",
                    "fieldIndex": 1,
                    "fieldUnits": "meter",
                    "scaleRange": {
                      "scaleFactor": 2.3283064370807974e-05,
                      "bias": -50000.0
                    }
                  },
                  {
                    "type": "number",
                    "jausType": "unsigned integer",
                    "comment": "",
                    "fieldIndex": 2,
                    "fieldUnits": "meter",
                    "scaleRange": {
                      "scaleFactor": 2.3283064370807974e-05,
                      "bias": -50000.0
                    }
                  },
                  {
                    "type": "number",
                    "jausType": "unsigned integer",
                    "comment": "",
                    "fieldIndex": 3,
                    "fieldUnits": "meter",
                    "scaleRange": {
                      "scaleFactor": 2.3283064370807974e-05,
                      "bias": -50000.0
                    }
                  }
                ]
              },
              "jausType": "unsigned byte",
              "minItems": 1,
              "maxItems": 1
            }
          }
        },
        "Loiter": {
          "type": "object",
          "comment": "",
          "required": [],
          "properties": {
            "HoverRec": {
              "type": "object",
              "comment": "",
              "required": [
                "HoverPreference",
                "XYTolerance",
                "ZTolerance"
              ],
              "properties": {
                "HoverPreference": {
                  "type": "string",
                  "jausType": "unsigned byte",
                  "comment": "",
                  "valueSet": [
                    {
                      "valueEnum": {
                        "enumIndex": 0,
                        "enumConst": "LatLonPriority"
                      }
                    },
                    {
                      "valueEnum": {
                        "enumIndex": 1,
                        "enumConst": "ZPriority"
                      }
                    }
                  ],
                  "enum": [
                    "LatLonPriority",
                    "ZPriority"
                  ]
                },
                "XYTolerance": {
                  "type": "number",
                  "jausType": "unsigned integer",
                  "comment": "",
                  "scaleRange": {
                    "scaleFactor": 2.3283064370807974e-05,
                    "bias": 0.0
                  }
                },
                "ZTolerance": {
                  "type": "number",
                  "jausType": "unsigned integer",
                  "comment": "",
                  "scaleRange": {
                    "scaleFactor": 1.1641532185403987e-05,
                    "bias": 0.0
                  }
                }
              }
            },
            "PolygonRec": {
              "type": "object",
              "comment": "",
              "required": [
                "NumberLoiterVertices",
                "XYExtent",
                "LoiterDirection",
                "LoiterBearing"
              ],
              "properties": {
                "NumberLoiterVertices": {
                  "type": "number",
                  "jausType": "unsigned byte",
                  "comment": "Number of vertices in loiter convex, regular polygon 0 and 1 are a circular loiter; 2 forms a linear loiter"
                },
                "XYExtent": {
                  "type": "number",
                  "jausType": "unsigned integer",
                  "comment": "Distance from loiter reference position to polygon vertices",
                  "scaleRange": {
                    "scaleFactor": 2.3283064370807974e-05,
                    "bias": 0.0
                  }
                },
                "LoiterDirection": {
                  "type": "string",
                  "jausType": "unsigned byte",
                  "comment": "",
                  "valueSet": [
                    {
                      "valueEnum": {
                        "enumIndex": 0,
                        "enumConst": "VehicleDependent"
                      }
                    },
                    {
                      "valueEnum": {
                        "enumIndex": 1,
                        "enumConst": "Clockwise"
                      }
                    },
                    {
                      "valueEnum": {
                        "enumIndex": 2,
                        "enumConst": "CounterClockwise"
                      }
                    }
                  ],
                  "enum": [
                    "VehicleDependent",
                    "Clockwise",
                    "CounterClockwise"
                  ]
                },
                "LoiterBearing": {
                  "type": "number",
                  "jausType": "unsigned short integer",
                  "comment": "Angular offset clockwise from North about Z-axis from the loiter reference position to the first vertex of the polygon; a value of zero for a 4-vertex polygon would create a diamond while a value of PI/4 would create a square",
                  "scaleRange": {
                    "scaleFactor": 4.793763109162727e-05,
                    "bias": 0.0
                  }
                }
              }
            },
            "RaceTrackRec": {
              "type": "object",
              "comment": "",
              "required": [
                "LoiterType",
                "LoiterRadius",
                "LoiterLength",
                "LoiterDirection",
                "LoiterBearing"
              ],
              "properties": {
                "LoiterType": {
                  "type": "string",
                  "jausType": "unsigned byte",
                  "comment": "",
                  "valueSet": [
                    {
                      "valueEnum": {
                        "enumIndex": 0,
                        "enumConst": "Racetrack"
                      }
                    },
                    {
                      "valueEnum": {
                        "enumIndex": 1,
                        "enumConst": "Figure8"
                      }
                    }
                  ],
                  "enum": [
                    "Racetrack",
                    "Figure8"
                  ]
                },
                "LoiterRadius": {
                  "type": "number",
                  "jausType": "unsigned integer",
                  "comment": "Width (smaller distance) of racetrack or figure 8",
                  "scaleRange": {
                    "scaleFactor": 4.656612874161595e-05,
                    "bias": 0.0
                  }
                },
                "LoiterLength": {
                  "type": "number",
                  "jausType": "unsigned integer",
                  "comment": "Length (larger distance) of racetrack or figure 8",
                  "scaleRange": {
                    "scaleFactor": 4.656612874161595e-05,
                    "bias": 0.0
                  }
                },
                "LoiterDirection": {
                  "type": "string",
                  "jausType": "unsigned byte",
                  "comment": "",
                  "valueSet": [
                    {
                      "valueEnum": {
                        "enumIndex": 0,
                        "enumConst": "VehicleDependent"
                      }
                    },
                    {
                      "valueEnum": {
                        "enumIndex": 1,
                        "enumConst": "Clockwise"
                      }
                    },
                    {
                      "valueEnum": {
                        "enumIndex": 2,
                        "enumConst": "CounterClockwise"
                      }
                    }
                  ],
                  "enum": [
                    "VehicleDependent",
                    "Clockwise",
                    "CounterClockwise"
                  ]
                },
                "LoiterBearing": {
                  "type": "number",
                  "jausType": "unsigned short integer",
                  "comment": "Angular offset of the length axis clockwise from North about Z-axis; a value of zero would orient the LoiterLength in the North-South direction while a value of PI/2 would orient it in the East-West direction.",
                  "scaleRange": {
                    "scaleFactor": 4.793763109162727e-05,
                    "bias": 0.0
                  }
                }
              }
            }
          },
          "jausType": "unsigned byte",
          "vtagMin": 0,
          "vtagMax": 2,
          "isVariant": true
        }
      }
    }
  },
  "required": [
    "HeaderRec",
    "GlobalLoiterSpecification"
  ]
}