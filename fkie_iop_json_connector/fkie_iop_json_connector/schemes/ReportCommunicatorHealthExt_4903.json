{
  "title": "ReportCommunicatorHealthExt",
  "messageId": "4903",
  "isCommand": false,
  "description": "This message is used to report the current health and status associated with this communication device. \n                     Note that if an EndpointID is specified, health is assumed to be measured from that endpoint to the local radio, such that the endpoint \n                     is the transmitter and the local radio is the receiver.",
