              "SensorName"
            ],
            "properties": {
              "SensorID": {
                "type": "number",
                "jausType": "unsigned short integer",
                "comment": "Zero (0) is not a valid sensor ID."
              },
              "SensorName": {
                "type": "string",
                "jausType": "unsigned byte",
                "comment": "",
                "minLength": 0,
                "maxLength": 255
              }
            }
          }
        ]
      },
      "jausType": "unsigned short integer",
      "minItems": 0,
      "maxItems": 65535,
      "isVariant": false
    }
