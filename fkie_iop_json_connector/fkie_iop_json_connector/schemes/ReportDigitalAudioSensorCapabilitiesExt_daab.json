        "MessageID"
      ],
      "properties": {
        "MessageID": {
          "type": "string",
          "jausType": "unsigned short integer",
          "comment": "A two byte field to hold the message ID of a message",
          "const": "daab"
        }
      }
    },
    "DigitalAudioSensorCapabilitiesExtList": {
      "type": "array",
      "comment": "",
