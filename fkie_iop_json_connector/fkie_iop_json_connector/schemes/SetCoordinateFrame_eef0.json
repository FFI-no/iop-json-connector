                  "bitRange": {
                    "from": 0,
                    "to": 7
                  },
                  "valueSet": [
                    {
                      "valueRange": {
                        "minimum": 1.0,
                        "maximum": 254.0,
                        "interpretation": ""
                      }
                    }
                  ]
                },
                "NodeID": {
