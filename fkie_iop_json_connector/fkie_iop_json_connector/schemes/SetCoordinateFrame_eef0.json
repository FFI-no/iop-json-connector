{
  "title": "SetCoordinateFrame",
  "messageId": "eef0",
  "isCommand": true,
  "description": "This message attemps to set the active frame of reference for end effector based motions.\n          The JAUS ID refers to the host of the frame.  Consequently, specifying a JAUS ID that is the same as the target of the message\n          with a link ID of 0 restores the frame of reference to the manipulator base coordinate frame, the default value for end effector services.\n\n          Each selected frame can have an additional offset, as specified by the optional record.\n\n          If the Follow mode is set to active, the manipulator will attempt to maintain a fixed relationship relative to the \n          selected coordinate frame if that frame moves independently.  This is particularly useful for two or more manipulators\n          attempting to move or carry the same object, where motion of the independent manipulator must induce motion of the dependent\n          manipulators to maintain a constant geometry. Follow mode can only be on/active when the manipulator is in the Management::READY\n          state.",
  "type": "object",
  "properties": {
    "HeaderRec": {
      "type": "object",
      "comment": "",
      "required": [
        "MessageID"
      ],
      "properties": {
        "MessageID": {
          "type": "string",
          "jausType": "unsigned short integer",
          "comment": "",
          "const": "eef0"
        }
      }
    },
