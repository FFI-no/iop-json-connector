                  "jausType": "unsigned integer",
                  "comment": "JAUS ID associated with this coordinate frame. For a frame associated with the local manipulator, the JAUS ID is simply the host of the service.",
                  "bitRange": {
                    "from": 8,
                    "to": 15
                  },
                  "valueSet": [
                    {
                      "valueRange": {
                        "minimum": 1.0,
                        "maximum": 254.0,
                        "interpretation": ""
                      }
                    }
                  ]
                },
                "SubsystemID": {
