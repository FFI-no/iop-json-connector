              "jausType": "unsigned byte",
              "comment": "Link associated with this coordinate frame. A value of zero refers to the base of the specified JAUS ID."
            },
            "FollowMode": {
              "type": "string",
              "jausType": "unsigned byte",
              "comment": "When follow mode is ON and the frame of reference is associated with different articulated JAUS ID, the local manipulator should attempt to follow any motion of the frame, maintaining a constant offset.",
              "valueSet": [
