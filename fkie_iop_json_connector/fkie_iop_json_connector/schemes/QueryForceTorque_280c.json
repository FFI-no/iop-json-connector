          "type": "string",
          "jausType": "unsigned short integer",
          "comment": "",
          "const": "280c"
        }
      }
    },
    "QueryForceTorqueList": {
      "type": "array",
      "comment": "",
      "required": [],
      "items": {
        "anyOf": [
          {
            "type": "object",
            "comment": "",
