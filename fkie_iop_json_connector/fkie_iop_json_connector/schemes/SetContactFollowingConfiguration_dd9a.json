{
  "title": "SetContactFollowingConfiguration",
  "messageId": "dd9a",
  "isCommand": true,
  "description": "Sets configuration for contact following.",
  "type": "object",
  "properties": {
    "HeaderRec": {
      "type": "object",
      "comment": "",
      "required": [
        "MessageID"
      ],
      "properties": {
        "MessageID": {
          "type": "string",
          "jausType": "unsigned short integer",
          "comment": "A two byte field to hold the message ID of a message",
          "const": "dd9a"
        }
      }
    },
    "ContactFollowingConfigurationSeq": {
      "type": "object",
      "comment": "",
      "required": [
        "presenceVector",
        "RequestIDRec"
      ],
      "properties": {
        "presenceVector": {
          "type": "number",
          "jausType": "unsigned byte",
          "comment": ""
        },
        "RequestIDRec": {
          "type": "object",
          "comment": "",
          "required": [
            "RequestID"
          ],
          "properties": {
            "RequestID": {
              "type": "number",
              "jausType": "unsigned short integer",
              "comment": "ID associated with the request. This is generated by the client and used to monitor responses from the service."
            }
          }
        },
        "FollowContactRec": {
          "type": "object",
          "comment": "Record identifying the contact to follow. If this record is omitted, the message is to be interpretted as a command to cease contact following.",
          "required": [
            "ContactID",
            "TrackingComponentJausID"
          ],
          "properties": {
            "ContactID": {
              "type": "number",
              "jausType": "unsigned short integer",
              "comment": "ID of the contact to follow. A value of zero (0) is not supported."
            },
            "TrackingComponentJausID": {
              "type": "object",
              "comment": "Address of the JAUS component on which the Contact Tracking service that identified this contact resides",
              "required": [
                "ComponentID",
                "NodeID",
                "SubsystemID"
              ],
              "properties": {
                "ComponentID": {
                  "type": "number",
                  "jausType": "unsigned integer",
                  "comment": "Address of the JAUS component on which the Contact Tracking service that identified this contact resides",
                  "bitRange": {
                    "from": 0,
                    "to": 7
                  },
                  "valueSet": [
                    {
                      "valueRange": {
                        "minimum": 1.0,
                        "maximum": 255.0,
                        "interpretation": ""
                      }
                    }
                  ]
                },
                "NodeID": {
                  "type": "number",
                  "jausType": "unsigned integer",
                  "comment": "Address of the JAUS component on which the Contact Tracking service that identified this contact resides",
                  "bitRange": {
                    "from": 8,
                    "to": 15
                  },
                  "valueSet": [
                    {
                      "valueRange": {
                        "minimum": 1.0,
                        "maximum": 255.0,
                        "interpretation": ""
                      }
                    }
                  ]
                },
                "SubsystemID": {
                  "type": "number",
                  "jausType": "unsigned integer",
                  "comment": "Address of the JAUS component on which the Contact Tracking service that identified this contact resides",
                  "bitRange": {
                    "from": 16,
                    "to": 31
                  },
                  "valueSet": [
                    {
                      "valueRange": {
                        "minimum": 1.0,
                        "maximum": 65535.0,
                        "interpretation": ""
                      }
                    }
                  ]
                }
              },
              "bitField": "unsigned integer"
            }
          }
        }
      }
    }
  },
  "required": [
    "HeaderRec",
    "ContactFollowingConfigurationSeq"
  ]
