{
  "title": "ConfirmHandoffRequest",
  "messageId": "ff45",
  "isCommand": false,
  "description": "Confirms that there is a response to a handoff request.  The response can be: GRANTED, meaning the request for handoff was granted and the requesting client has control; NOT_AVAILABLE, meaning control (and thus handoff) is not available; HANDOFF_REQUEST_TIMEOUT, meaning the handoff request timed out because it was not re-issued within a set amount of time to the handoff request; DENIED, meaning the current controlling client rejected the request for handoff; QUEUED, meaning the handoff request was queued and pending; DEFERRED, meaning the current controller is not prepared to make a decision on the request; INSUFFICIENT_AUTHORITY, meaning the request did not have a high enough authority code to control the service; HANDOFF_DECISION_TIMEOUT, meaning the current controller did not respond within a set amount of time to the handoff request;  SERVICE_NOT_CONTROLLED, meaning that the service is not currently being controlled; or REMOVED, meaning that the handoff request was removed from the queue.",
  "type": "object",
  "properties": {
    "HeaderRec": {
      "type": "object",
      "comment": "",
      "required": [
        "MessageID"
      ],
      "properties": {
        "MessageID": {
          "type": "string",
          "jausType": "unsigned short integer",
          "comment": "",
          "const": "ff45"
        }
      }
    },
