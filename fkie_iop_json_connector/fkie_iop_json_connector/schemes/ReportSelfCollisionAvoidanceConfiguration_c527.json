            {
              "valueEnum": {
                "enumIndex": 0,
                "enumConst": "DoNothing"
              }
            },
            {
              "valueEnum": {
                "enumIndex": 1,
                "enumConst": "StopOnPath"
              }
            },
            {
              "valueEnum": {
